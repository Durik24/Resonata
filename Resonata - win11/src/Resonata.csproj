<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Resonata</RootNamespace>
    <AssemblyName>Resonata</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon and its menu; see Tray.cs. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Resonata.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <Product>Resonata</Product>
    <Company>Resonata</Company>
    <Copyright>Copyright (c) 2026 Josef Kupec</Copyright>
    <!-- ThemeMode on the settings window is still marked experimental. -->
    <!-- WFO0003: the DPI setting in app.manifest is for WPF, which reads it from there. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and Windows Forms both define Application, Button and the rest. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Resource Include="Assets\Resonata.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ical.Net" Version="5.*" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
