<Window x:Class="Resonata.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Resonata"
        Title="Resonata"
        Width="700" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" Foreground="White">
    <Grid x:Name="Root">
        <!-- Its own element so the shadow is redrawn only while the shape moves,
             not with every frame of the wave. -->
        <Path x:Name="ShadowShape" Fill="Black" IsHitTestVisible="False" Opacity="0.9">
            <Path.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.45" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- The size of the window and never resized: only its clip follows the
             spring. Sized to the shape, every frame would lay the content out
             again and round it to whole pixels, and it visibly trembled. -->
        <Grid x:Name="Shape">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShapeShift"/>
            </Grid.RenderTransform>

            <Rectangle Fill="Black"/>
            <Rectangle x:Name="Wash"/>

            <local:MusicWave x:Name="Wave" Height="26" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,170,0,0" Visibility="Collapsed" Opacity="0"/>

            <Grid x:Name="Pill" Width="279" Height="32" Margin="209,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="CoverSlot" Grid.Column="0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                    <TextBlock x:Name="PillTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PillDetail" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid x:Name="TrailSlot" Grid.Column="2"/>
            </Grid>

            <Grid x:Name="Expanded" Height="204" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Visibility="Hidden" Opacity="0" RenderTransformOrigin="0.5,0">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ExpandedScale"/>
                </Grid.RenderTransform>
                <Grid x:Name="Pages" ClipToBounds="True" Margin="0,46,0,18"/>
                <Grid x:Name="TopBar" Height="38" VerticalAlignment="Top">
                    <Canvas x:Name="PageStrip" HorizontalAlignment="Left" Width="155" Height="20"/>
                    <StackPanel x:Name="StatusItems" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
